default_platform(:ios)

platform :ios do
  desc "Sign PiStick and optionally upload it to TestFlight"
  lane :testflight do
    bundle_id = ENV.fetch("PISTICK_BUNDLE_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    build_number = ENV.fetch("PISTICK_BUILD_NUMBER", "1")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
      duration: 1_200,
      in_house: false
    )

    match(
      type: "appstore",
      app_identifier: bundle_id,
      git_url: ENV.fetch("MATCH_REPOSITORY_URL"),
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      api_key: api_key,
      readonly: false,
      team_id: team_id
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "PiStick.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{bundle_id}",
      targets: ["PiStick"]
    )

    increment_build_number(
      build_number: build_number,
      xcodeproj: "PiStick.xcodeproj"
    )

    build_app(
      project: "PiStick.xcodeproj",
      scheme: "PiStick",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "PiStick.ipa",
      xcargs: "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id} DEVELOPMENT_TEAM=#{team_id}",
      export_options: {
        provisioningProfiles: {
          bundle_id => "match AppStore #{bundle_id}"
        }
      }
    )

    if ENV.fetch("UPLOAD_TO_TESTFLIGHT", "true") == "true"
      upload_to_testflight(
        api_key: api_key,
        ipa: "build/PiStick.ipa",
        skip_waiting_for_build_processing: true
      )
    end
  end
end
